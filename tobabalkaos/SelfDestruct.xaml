<Page x:Class="tobabalkaos.SelfDestruct"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F8FAFC">

    <Grid Margin="40">

        <StackPanel>

            <TextBlock Text="Önmegsemmisítés"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#1E293B"/>

            <Button Content="Önmegsemmisítés"
                    Height="45"
                    Click="SelfDestruct_Click"
                    Margin="0,30,0,30"/>

            <Button Content="Vissza"
                    Height="45"
                    Click="Back_Click"
                    Margin="0,0,0,30"/>


        </StackPanel>

    </Grid>

</Page>
